# Source API keys and secrets (not tracked by git/home-manager)
[ -f "$HOME/.config/secrets/env" ] && source "$HOME/.config/secrets/env"

alias ls='ls --color=auto'
alias rm='echo "rm is disabled, use trash/trash-put/rmt for safe rm or remove (/bin/rm) for removing file."'
alias remove='/bin/rm -irv'
alias rmt=trash-put
alias vi=nvim
alias vim=nvim
alias la='ls -la'
alias ll='ls -l'
set -o vi
cdc () {
    cd $(ec)
}
alatheme() {
  ln -fs ~/.config/alacritty/themes/$1.toml ~/.config/alacritty/themes/active.toml
}
# Alacritty theme switcher
if [ "$ALACRITTY" = "true" ]
then
  theme() {
    ln -sf $HOME/.config/alacritty/themes/$1.toml $HOME/.config/alacritty/active-theme.toml
  }
  local ALACRITTY_THEME=$(defaults read -g AppleInterfaceStyle 2>/dev/null || echo "Light")
  if [ "$ALACRITTY_THEME" = "Dark" ]
  then
    theme "catppuccin-dark"
  else
    theme "gh-light-hc"
  fi
fi
# Start tmux by default with ssh sessions
if [[ $- =~ i ]] && [[ -z "$TMUX" ]] && [[ -n "$SSH_TTY" ]]; then
  tmux attach-session -t ssh_tmux || tmux new-session -s ssh_tmux
fi
