diff --git a/internal/runtime/executor/non_claude_cache_retention.go b/internal/runtime/executor/non_claude_cache_retention.go
new file mode 100644
index 0000000..6ea381e
--- /dev/null
+++ b/internal/runtime/executor/non_claude_cache_retention.go
@@ -0,0 +1,101 @@
+// Package executor provides runtime execution capabilities for various AI service providers.
+// This file implements the final outbound-boundary sanitizer for prompt_cache_retention,
+// the OpenAI Responses-platform cache TTL control that non-Claude upstreams reject.
+package executor
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// stripPromptCacheRetention removes every top-level prompt_cache_retention
+// field from an outbound JSON request body.
+//
+// prompt_cache_retention is an OpenAI Responses-platform TTL control. The
+// ChatGPT/Codex subscription backend rejects it with HTTP 400
+// ("prompt_cache_retention is not supported on this model"), and the
+// third-party Claude-compatible and xAI upstreams do not support it either.
+// Historical sanitization was scattered across executor paths and ran before
+// later transformations, so a reintroduced field could still leak upstream.
+// This helper is applied at each final outbound boundary — after every
+// transformation that can mutate the body — as an invariant rather than an
+// early cleanup.
+//
+// The helper removes only top-level occurrences, and all of them: a body
+// carrying duplicate prompt_cache_retention keys must leave sanitized as
+// well (sjson.DeleteBytes removes a single occurrence and cannot prove the
+// result). prompt_cache_key and nested prompt_cache_retention entries are
+// preserved. The helper is idempotent and fails closed — callers must not
+// send the body upstream when an error is returned — and enforces a
+// postcondition: the returned body is valid JSON and provably free of the
+// top-level field. An empty or nil body is invalid JSON and fails closed
+// with the same error; there is no body that can be proven retention-free.
+func stripPromptCacheRetention(body []byte) ([]byte, error) {
+	if !gjson.ValidBytes(body) {
+		return nil, fmt.Errorf("strip prompt_cache_retention: body is not valid JSON")
+	}
+	if !gjson.GetBytes(body, "prompt_cache_retention").Exists() {
+		return body, nil
+	}
+	// Rebuilding the top level from a map removes every duplicate occurrence
+	// of the key; re-marshaling preserves the untouched raw values.
+	var obj map[string]json.RawMessage
+	if err := json.Unmarshal(body, &obj); err != nil {
+		return nil, fmt.Errorf("strip prompt_cache_retention: body is not a JSON object: %w", err)
+	}
+	delete(obj, "prompt_cache_retention")
+	updated, err := json.Marshal(obj)
+	if err != nil {
+		return nil, fmt.Errorf("strip prompt_cache_retention: %w", err)
+	}
+	// Postcondition: no outbound body may leave sanitized unless it is valid
+	// JSON and provably free of the top-level field.
+	if !gjson.ValidBytes(updated) || gjson.GetBytes(updated, "prompt_cache_retention").Exists() {
+		return nil, fmt.Errorf("strip prompt_cache_retention: postcondition failed: field still present in sanitized body")
+	}
+	return updated, nil
+}
+
+// claudeUpstreamRequiresRetentionStrip reports whether a Claude-messages
+// request is headed to a third-party Claude-compatible upstream that does not
+// support prompt_cache_retention.
+//
+// Classification is endpoint-first: only the official Anthropic transport is
+// preserved — the empty base URL (which the Claude executors resolve to
+// https://api.anthropic.com) or a resolved HTTPS api.anthropic.com endpoint
+// with the default (or explicit 443) port; the hostname is matched
+// case-insensitively and any path is accepted. Every other base URL — custom
+// hosts, non-HTTPS schemes, non-default ports, malformed values — fails
+// closed as third-party regardless of token shape: an OAuth-shaped token
+// never makes a non-official endpoint official.
+func claudeUpstreamRequiresRetentionStrip(baseURL string) bool {
+	trimmed := strings.TrimSpace(baseURL)
+	if trimmed == "" {
+		// Default route: resolved by the executors to the official endpoint.
+		return false
+	}
+	parsed, err := url.Parse(trimmed)
+	if err != nil {
+		return true
+	}
+	if !strings.EqualFold(parsed.Scheme, "https") {
+		return true
+	}
+	if !strings.EqualFold(parsed.Hostname(), "api.anthropic.com") {
+		return true
+	}
+	port := parsed.Port()
+	if port != "" && port != "443" {
+		return true
+	}
+	// An explicit but invalid port (e.g. api.anthropic.com:abc) parses to an
+	// empty Port(): fail closed rather than treat the endpoint as official.
+	if port == "" && strings.Contains(parsed.Host, ":") {
+		return true
+	}
+	return false
+}
