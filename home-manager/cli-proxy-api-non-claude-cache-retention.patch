@@ -0,0 +1,1197 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/pierrec/xxHash/xxHash64"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	_ "github.com/router-for-me/CLIProxyAPI/v7/internal/translator"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// These tests pin the final outbound-boundary invariant for
+// prompt_cache_retention: non-Claude upstreams (Codex, third-party
+// Claude-compatible endpoints, xAI) must never receive the OpenAI
+// Responses-platform TTL control, while official Anthropic transport and
+// supported OpenAI-compatible Responses routes must keep it. All upstreams
+// are loopback fakes or injected round-trippers; no external network access
+// is involved.
+
+func assertRetentionStripped(t *testing.T, body []byte) {
+	t.Helper()
+	if gjson.GetBytes(body, "prompt_cache_retention").Exists() {
+		t.Fatalf("upstream body still contains prompt_cache_retention: %s", string(body))
+	}
+}
+
+func assertRetentionPresent(t *testing.T, body []byte) {
+	t.Helper()
+	if !gjson.GetBytes(body, "prompt_cache_retention").Exists() {
+		t.Fatalf("upstream body lost prompt_cache_retention: %s", string(body))
+	}
+}
+
+// assertCCHMatchesSanitizedBody recomputes the CCH over the captured outbound
+// body exactly as signAnthropicMessagesBody does (cch zeroed, then xxHash64
+// with the CCH seed) and fails unless the emitted cch equals it. This proves
+// the signature was computed over the sanitized body that actually left —
+// i.e. the retention strip ran before signing, not after.
+func assertCCHMatchesSanitizedBody(t *testing.T, body []byte) {
+	t.Helper()
+	billingHeader := gjson.GetBytes(body, "system.0.text").String()
+	if !strings.HasPrefix(billingHeader, "x-anthropic-billing-header:") {
+		t.Fatalf("system.0.text = %q, want x-anthropic-billing-header; body=%s", billingHeader, string(body))
+	}
+	match := claudeBillingHeaderCCHPattern.FindStringSubmatch(billingHeader)
+	if len(match) != 2 {
+		t.Fatalf("no cch=xxxxx in billing header %q; body=%s", billingHeader, string(body))
+	}
+	emitted := match[1]
+	if emitted == "00000" {
+		t.Fatalf("emitted cch is still 00000, signing did not run; body=%s", string(body))
+	}
+	unsignedHeader := claudeBillingHeaderCCHPattern.ReplaceAllString(billingHeader, "cch=00000;")
+	unsignedBody, err := sjson.SetBytes(body, "system.0.text", unsignedHeader)
+	if err != nil {
+		t.Fatalf("recompute unsigned body: %v", err)
+	}
+	want := fmt.Sprintf("%05x", xxHash64.Checksum(unsignedBody, claudeCCHSeed)&0xFFFFF)
+	if emitted != want {
+		t.Fatalf("emitted cch = %q, want %q (hash of the sanitized outbound body); body=%s", emitted, want, string(body))
+	}
+}
+
+// Shared sanitizer helper.
+
+func TestStripPromptCacheRetentionRemovesOnlyTopLevelField(t *testing.T) {
+	body := []byte(`{"model":"gpt-5.6-sol","prompt_cache_retention":"24h","prompt_cache_key":"cache-123","input":[{"type":"message","prompt_cache_retention":"nested"}]}`)
+	out, err := stripPromptCacheRetention(body)
+	if err != nil {
+		t.Fatalf("stripPromptCacheRetention() error = %v", err)
+	}
+	assertRetentionStripped(t, out)
+	if got := gjson.GetBytes(out, "prompt_cache_key").String(); got != "cache-123" {
+		t.Fatalf("prompt_cache_key = %q, want cache-123; body=%s", got, string(out))
+	}
+	if got := gjson.GetBytes(out, "input.0.prompt_cache_retention").String(); got != "nested" {
+		t.Fatalf("nested prompt_cache_retention = %q, want preserved nested; body=%s", got, string(out))
+	}
+	if got := gjson.GetBytes(out, "model").String(); got != "gpt-5.6-sol" {
+		t.Fatalf("model = %q, want gpt-5.6-sol; body=%s", got, string(out))
+	}
+}
+
+func TestStripPromptCacheRetentionRemovesAllDuplicateTopLevelFields(t *testing.T) {
+	// Duplicate top-level keys: the sanitizer must remove every occurrence,
+	// not just the first one a JSON lookup finds.
+	body := []byte(`{"prompt_cache_retention":"24h","model":"gpt-5.6-sol","prompt_cache_retention":"48h","prompt_cache_key":"cache-123","prompt_cache_retention":"72h","input":[{"type":"message","prompt_cache_retention":"nested"}]}`)
+	out, err := stripPromptCacheRetention(body)
+	if err != nil {
+		t.Fatalf("stripPromptCacheRetention() error = %v", err)
+	}
+	assertRetentionStripped(t, out)
+	if got := gjson.GetBytes(out, "prompt_cache_key").String(); got != "cache-123" {
+		t.Fatalf("prompt_cache_key = %q, want cache-123; body=%s", got, string(out))
+	}
+	if got := gjson.GetBytes(out, "input.0.prompt_cache_retention").String(); got != "nested" {
+		t.Fatalf("nested prompt_cache_retention = %q, want preserved nested; body=%s", got, string(out))
+	}
+	if got := gjson.GetBytes(out, "model").String(); got != "gpt-5.6-sol" {
+		t.Fatalf("model = %q, want gpt-5.6-sol; body=%s", got, string(out))
+	}
+}
+
+func TestStripPromptCacheRetentionAbsentReturnsBodyUnchanged(t *testing.T) {
+	body := []byte(`{"model":"gpt-5.6-sol","prompt_cache_key":"cache-123","input":[]}`)
+	out, err := stripPromptCacheRetention(body)
+	if err != nil {
+		t.Fatalf("stripPromptCacheRetention() error = %v", err)
+	}
+	if !bytes.Equal(out, body) {
+		t.Fatalf("body mutated when field absent: %s", string(out))
+	}
+}
+
+func TestStripPromptCacheRetentionIdempotent(t *testing.T) {
+	body := []byte(`{"prompt_cache_retention":"24h","model":"gpt-5.6-sol"}`)
+	once, err := stripPromptCacheRetention(body)
+	if err != nil {
+		t.Fatalf("stripPromptCacheRetention() error = %v", err)
+	}
+	twice, err := stripPromptCacheRetention(once)
+	if err != nil {
+		t.Fatalf("stripPromptCacheRetention() second call error = %v", err)
+	}
+	if !bytes.Equal(once, twice) {
+		t.Fatalf("strip is not idempotent: once=%s twice=%s", string(once), string(twice))
+	}
+}
+
+func TestStripPromptCacheRetentionFailsClosedOnMalformedJSON(t *testing.T) {
+	for _, body := range [][]byte{
+		[]byte(`{"prompt_cache_retention":"24h"`),
+		[]byte(`not json at all`),
+		// Empty and nil bodies are invalid JSON and must fail closed too:
+		// there is no body that can be proven retention-free.
+		[]byte{},
+		nil,
+	} {
+		if _, err := stripPromptCacheRetention(body); err == nil {
+			t.Fatalf("stripPromptCacheRetention(%q, len=%d) error = nil, want fail-closed error", string(body), len(body))
+		}
+	}
+}
+
+func TestClaudeUpstreamRequiresRetentionStripEndpointFirstClassification(t *testing.T) {
+	cases := []struct {
+		name    string
+		baseURL string
+		want    bool
+	}{
+		// Official Anthropic transport is preserved.
+		{name: "default empty base url", baseURL: "", want: false},
+		{name: "official anthropic base url", baseURL: "https://api.anthropic.com", want: false},
+		{name: "official anthropic base url with path", baseURL: "https://api.anthropic.com/v1", want: false},
+		{name: "official anthropic base url uppercase host", baseURL: "https://API.ANTHROPIC.COM/v1/messages", want: false},
+		{name: "official anthropic base url with default port", baseURL: "https://api.anthropic.com:443/v1", want: false},
+		{name: "official anthropic base url with default port only", baseURL: "https://api.anthropic.com:443", want: false},
+		// Anything else fails closed as third-party, regardless of token shape.
+		{name: "plain http scheme", baseURL: "http://api.anthropic.com", want: true},
+		{name: "non-default port", baseURL: "https://api.anthropic.com:8443", want: true},
+		{name: "invalid explicit port", baseURL: "https://api.anthropic.com:abc", want: true},
+		{name: "lookalike host", baseURL: "https://api.anthropic.com.evil.example", want: true},
+		{name: "kimi coding base url", baseURL: "https://api.kimi.com/coding", want: true},
+		{name: "qwen maas base url", baseURL: "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic", want: true},
+		{name: "deepseek anthropic base url", baseURL: "https://api.deepseek.com/anthropic", want: true},
+		{name: "openrouter base url", baseURL: "https://openrouter.ai/api", want: true},
+		{name: "unparseable base url fails closed", baseURL: "://not a url", want: true},
+		{name: "schemeless base url fails closed", baseURL: "api.anthropic.com/v1", want: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := claudeUpstreamRequiresRetentionStrip(tc.baseURL); got != tc.want {
+				t.Fatalf("claudeUpstreamRequiresRetentionStrip(%q) = %v, want %v", tc.baseURL, got, tc.want)
+			}
+		})
+	}
+}
+
