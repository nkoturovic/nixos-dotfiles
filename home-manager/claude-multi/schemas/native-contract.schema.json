{
  "version": 1,
  "type": "object",
  "required": ["version", "claude", "effort_vocabulary", "generic_agent_aliases", "capabilities", "nested_subagents", "acceptance", "lifecycle_evidence", "evidence_version", "recorded_at"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "claude": {
      "type": "object",
      "required": ["validated_version", "executable"],
      "additionalProperties": false,
      "properties": {
        "validated_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "executable": {
          "type": "object",
          "required": ["configured_path", "resolved_path", "sha256", "inspection", "inspected_at"],
          "additionalProperties": false,
          "properties": {
            "configured_path": { "type": "string", "pattern": "^/[a-z0-9._/-]+$" },
            "resolved_path": { "type": "string", "pattern": "^/[a-z0-9._/-]+$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "inspection": { "type": "string", "minLength": 1, "maxLength": 256 },
            "inspected_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        }
      }
    },
    "effort_vocabulary": {
      "type": "object",
      "required": ["values", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "status": { "enum": ["provisionally-trusted", "verified", "unverified"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "generic_agent_aliases": {
      "type": "object",
      "required": ["values", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "status": { "enum": ["provisionally-trusted", "verified", "unverified"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["pending", "verified", "failed"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "nested_subagents": {
      "type": "object",
      "required": ["decision", "depth_key", "concurrency_key", "probe", "evidence"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["pending", "compile-verified-keys", "amend-prompts"] },
        "depth_key": {
          "type": "object",
          "required": ["name", "status"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH" },
            "status": { "enum": ["unverified", "verified", "failed"] }
          }
        },
        "concurrency_key": {
          "type": "object",
          "required": ["name", "status"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS" },
            "status": { "enum": ["unverified", "verified", "failed"] }
          }
        },
        "probe": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["unverified", "verified", "failed"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "lifecycle_evidence": {
      "type": "object",
      "required": ["inspected_version", "evidence_id"],
      "additionalProperties": false,
      "properties": {
        "inspected_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9.-]*$" }
      }
    },
    "evidence_version": { "type": "integer", "minimum": 1 },
    "recorded_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
