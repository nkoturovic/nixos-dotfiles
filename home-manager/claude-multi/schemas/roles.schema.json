{
  "version": 1,
  "type": "object",
  "required": ["version", "roles"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "roles": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["summary", "prompt_file", "isolation", "tools", "disallowed_tools"],
        "additionalProperties": false,
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 256 },
          "prompt_file": { "type": "string", "pattern": "^prompts/cm-[a-z0-9-]+\\.md$" },
          "isolation": {
            "oneOf": [
              { "const": "worktree" },
              { "type": "null" }
            ]
          },
          "tools": {
            "oneOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
              },
              { "type": "null" }
            ]
          },
          "disallowed_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
          }
        }
      }
    }
  }
}
