diff --git a/sdk/cliproxy/service_oauth_model_alias_test.go b/sdk/cliproxy/service_oauth_model_alias_test.go
--- a/sdk/cliproxy/service_oauth_model_alias_test.go
+++ b/sdk/cliproxy/service_oauth_model_alias_test.go
@@ -5,0 +6 @@ import (
+	internalregistry "github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
@@ -154,0 +156,57 @@ func TestApplyOAuthModelAlias_PerAuthAlias(t *testing.T) {
+
+func TestApplyOAuthModelAlias_CodexSolPreservesTokenLimits(t *testing.T) {
+	const (
+		sourceID                = "gpt-5.6-sol"
+		wantContextLength       = 372000
+		wantMaxCompletionTokens = 128000
+	)
+
+	var source *ModelInfo
+	for _, model := range internalregistry.GetStaticModelDefinitionsByChannel("codex") {
+		if model != nil && model.ID == sourceID {
+			source = model
+			break
+		}
+	}
+	if source == nil {
+		t.Fatalf("expected Codex registry model %q", sourceID)
+	}
+	if source.ContextLength != wantContextLength {
+		t.Fatalf("source context length = %d, want %d", source.ContextLength, wantContextLength)
+	}
+	if source.MaxCompletionTokens != wantMaxCompletionTokens {
+		t.Fatalf("source max completion tokens = %d, want %d", source.MaxCompletionTokens, wantMaxCompletionTokens)
+	}
+
+	aliases := []string{
+		"claude-multi-sol-high",
+		"gpt-multi-sol-high",
+		"claude-multi-sol-xhigh",
+		"gpt-multi-sol-xhigh",
+	}
+	for _, alias := range aliases {
+		t.Run(alias, func(t *testing.T) {
+			cfg := &config.Config{
+				OAuthModelAlias: map[string][]config.OAuthModelAlias{
+					"codex": {
+						{Name: sourceID, Alias: alias, ForceMapping: true},
+					},
+				},
+			}
+
+			out := applyOAuthModelAlias(cfg, "codex", "oauth", []*ModelInfo{source})
+			if len(out) != 1 {
+				t.Fatalf("expected 1 aliased model, got %d", len(out))
+			}
+			if out[0].ID != alias {
+				t.Fatalf("alias model id = %q, want %q", out[0].ID, alias)
+			}
+			if out[0].ContextLength != wantContextLength {
+				t.Fatalf("alias context length = %d, want %d", out[0].ContextLength, wantContextLength)
+			}
+			if out[0].MaxCompletionTokens != wantMaxCompletionTokens {
+				t.Fatalf("alias max completion tokens = %d, want %d", out[0].MaxCompletionTokens, wantMaxCompletionTokens)
+			}
+		})
+	}
+}
